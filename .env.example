# ===== LLM API =====
# Any OpenAI-SDK-compatible API works (OpenAI, DeepSeek, Qwen/DashScope, local servers, ...).
# OpenAI SDK 호환 API면 무엇이든 됩니다. 비용이 크니 처음에는 40라운드 미만으로 시험해 보세요.
# 支持 OpenAI SDK 格式的任意 LLM API；消耗较大，可先进行小于40轮的模拟尝试。
# No API key? Sign in with your ChatGPT plan instead: see LLM_PROFILES (kind "chatgpt_oauth") below.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== Graph backend (그래프 백엔드 / 图谱后端) =====
# Select local (default without ZEP_API_KEY) or zep_cloud (requires a key).
# local(기본값, 키 없이 사용) 또는 zep_cloud(ZEP_API_KEY 필요)를 선택합니다.
# 选择 local（未设置密钥时的默认值）或 zep_cloud（需要 ZEP_API_KEY）。
# GRAPH_BACKEND=local
# GRAPH_LOCAL_DB=backend/uploads/graph_local.db
# GRAPH_LOCAL_EMBEDDINGS=off
# Zep Cloud is optional; set a key to default to it, or select GRAPH_BACKEND=zep_cloud.
# ZEP_API_KEY=your_zep_api_key_here

# ===== Boost LLM (optional / 선택 / 可选) =====
# If you do not use it, delete these three lines entirely (never leave them blank).
# 사용하지 않으면 아래 세 줄을 통째로 지우세요(빈 값으로 두지 마세요).
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# ===== 多 provider / multi-provider (optional) =====
# Leave these unset to keep the single "default" profile above (and "boost" when set).
# LLM_PROFILES: JSON list (inline) or path to a .json file. Keys are never written inline:
#   api_key_env names the env var holding the key. kind: openai_compatible | chatgpt_oauth | claude_code_cli | cursor_agent_cli.
#   An entry with id "default" or "boost" replaces the legacy profile of that id.
# LLM_PROFILES=[{"id":"cheap","label":"DeepSeek","kind":"openai_compatible","model":"deepseek-chat","base_url":"https://api.deepseek.com/v1","api_key_env":"DEEPSEEK_API_KEY"},{"id":"chatgpt","label":"ChatGPT","kind":"chatgpt_oauth","model":"gpt-5"}]
# Optional per-profile fields: "extra_headers": {"Header": "value"}, "supports_json_mode": false
# DEEPSEEK_API_KEY=your_api_key_here
#
# Claude subscription via your own signed-in Claude Code CLI (run `claude`, then `/login`); MiroFish never sees your Claude credentials; plan limits assume ordinary individual use.
# 내 Claude 구독 사용: 터미널에서 `claude` 실행 후 `/login`으로 로그인하면 됩니다. MiroFish는 Claude 로그인 정보를 보지 않으며, 구독 한도는 일반적인 개인 사용 기준입니다.
# 使用你自己的 Claude 订阅：在终端运行 `claude` 后输入 `/login` 登录；MiroFish 不接触你的 Claude 凭据；订阅额度按普通个人使用设计。
# LLM_PROFILES=[{"id":"claude","label":"Claude (내 구독)","kind":"claude_code_cli","model":"sonnet"}]
# Optional: CLAUDE_CLI_PATH=/path/to/claude  CLI_TIMEOUT_SECONDS=180  CLI_MAX_CONCURRENCY=2
# Cursor subscription via your own signed-in Cursor CLI (run `agent login` in a terminal); pick a model id from `agent models`. Token usage is estimated (chars/4).
# 내 Cursor 구독 사용: 터미널에서 `agent login`으로 로그인하고, model 값은 `agent models` 목록에서 고르세요. 토큰 사용량은 추정치(글자 수÷4)입니다.
# 使用你自己的 Cursor 订阅：在终端运行 `agent login` 登录；model 从 `agent models` 列表中选择。token 用量为估算值（字符数÷4）。
# LLM_PROFILES=[{"id":"cursor","label":"Cursor (내 구독)","kind":"cursor_agent_cli","model":"<from agent models>"}]
# Optional: CURSOR_CLI_PATH=/path/to/agent
#
# LLM_ROUTES: JSON {stage: profile_id}; unlisted stages use "default" (or the first profile).
#   Stages: ontology, profile, config, report, report_chat, interview, search_planning, simulation_agent
# LLM_ROUTES={"report":"chatgpt","simulation_agent":"cheap"}
#
# LLM_AGENT_POOL: profiles shared among simulated agents: "id1,id2" (equal) or JSON weights.
#   Default: the simulation_agent route.
# LLM_AGENT_POOL={"cheap":3,"default":1}
